# TEMPLATE ONLY — copy to credentials/project.env and fill private credentials locally.
# Never commit credentials/project.env.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
ARMORED_CREATOR_BOT_TOKEN=
GEMINI_API_KEY=
# Caminho absoluto do telegram-bot-api.exe nesta máquina (obrigatório para START_ALL.bat).
BOT_API_EXE=
BOT_API_PORT=8081
SHOPEE_APP_ID=
SHOPEE_SECRET_KEY=

ARMORED_REAL_TELEGRAM=1
ARMORED_HUB_DRY_RUN=0
ARMORED_REQUIRED_SOURCE_COUNT=3
ARMORED_IA_ENABLED=1
ARMORED_IA_CAPTION_ENABLED=1
ARMORED_IA_MODEL=gemini-3.1-flash-lite
ARMORED_IA_API_TIMEOUT=90
ARMORED_IA_MAX_CANDIDATES=10
ARMORED_IA_MAX_ATTEMPTS=5
ARMORED_IA_RETRY_DELAY=2
ARMORED_IA_AUDIENCE=público brasileiro de descoberta e lifestyle
ARMORED_TELEGRAM_CONNECTION_POOL_SIZE=4
ARMORED_TELEGRAM_CONNECT_TIMEOUT=15
ARMORED_TELEGRAM_READ_TIMEOUT=60
ARMORED_TELEGRAM_WRITE_TIMEOUT=180
ARMORED_TELEGRAM_POOL_TIMEOUT=15
SHOPEE_AFFILIATE_API_URL=https://open-api.affiliate.shopee.com.br/graphql

# Audio Intelligence: only confidently identified Portuguese speech uses RVC.
# First speech item downloads/caches this small multilingual Whisper model.
ARMORED_AUDIO_LANGUAGE_MODEL=openai/whisper-tiny
ARMORED_AUDIO_LANGUAGE_SECONDS=8
ARMORED_AUDIO_LANGUAGE_MIN_CONFIDENCE=0.20

